{
  "name": "liceu-6-core-runtime",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "infra:up": "docker compose -f infra/runtime/docker-compose.runtime.yml up -d",
    "infra:down": "docker compose -f infra/runtime/docker-compose.runtime.yml down",
    "graph:init": "node scripts/init-graph-runtime.js",
    "schema:init": "node scripts/init-schema-registry.js",
    "observability:init": "node scripts/init-observability.js",
    "federation:bootstrap": "node scripts/bootstrap-federation.js",
    "runtime:health": "node scripts/runtime-health.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/auto-instrumentations-node": "^0.48.0",
    "nats": "^2.28.2",
    "zod": "^3.23.8",
    "uuid": "^11.0.3",
    "jsonwebtoken": "^9.0.2",
    "neo4j-driver": "^5.24.0",
    "prom-client": "^15.1.3",
    "protobufjs": "^7.4.0",
    "avsc": "^5.7.7"
  }
}
