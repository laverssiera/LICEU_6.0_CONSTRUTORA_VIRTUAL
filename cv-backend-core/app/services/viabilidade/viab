class CheckDocumento(BaseModel):
    id_estudo: int
    documentos: dict # Ex: {"matricula_atualizada": True}

@router.post("/atualizar-compliance/")
async def atualizar_compliance(dados: CheckDocumento, db: Session = Depends(get_db)):
    estudo = db.query(EstudoViabilidade).filter(EstudoViabilidade.id == dados.id_estudo).first()
    if not estudo:
        raise HTTPException(status_code=404, detail="Estudo não encontrado")
    
    # Atualiza o JSON de documentos
    estudo.documentos_json.update(dados.documentos)
    
    # Recalcula o Score
    resultado = calcular_compliance_spe(estudo.documentos_json)
    estudo.score_compliance = resultado["score"]
    
    db.commit()
    return resultado
from app.services.juridico.contratos import GeradorContratoLiceu

@router.get("/gerar-contrato/{id_estudo}")
async def emitir_contrato_spe(id_estudo: int, investidor: str, db: Session = Depends(get_db)):
    estudo = db.query(EstudoViabilidade).filter(EstudoViabilidade.id == id_estudo).first()
    
    # TRAVA JURÍDICA: Só gera se o score for 100
    if estudo.score_compliance < 100:
        raise HTTPException(status_code=403, detail="Compliance insuficiente para gerar contrato.")

    dados_contrato = {
        "matricula": estudo.matricula,
        "cep": estudo.cep,
        "vgv": estudo.vgv,
        "investimento_total": estudo.investimento_total
    }
    
    filename = f"relatorios/CONTRATO_SPE_{estudo.id}.pdf"
    GeradorContratoLiceu().criar_minuta_spe(dados_contrato, investidor, filename)
    
    return {"status": "Contrato Gerado", "url": f"/baixar-pdf/CONTRATO_SPE_{estudo.id}.pdf"}


