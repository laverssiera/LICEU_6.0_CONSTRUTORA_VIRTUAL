def plano_pintura_industrial(area_parede_m2, tipo_superficie):
    """
    Calcula consumo exato para aplicação no Galpão (Airless ou Robotizada).
    Garante durabilidade mínima de 5 anos (Norma IPT).
    """
    # Rendimento médio por demão (m2/litro)
    rendimento = 12 if tipo_superficie == "PAINEL_LICEU" else 8
    
    litros_necessarios = (area_parede_m2 / rendimento) * 3 # 3 demãos
    
    return {
        "material": "Tinta Acrílica Premium Elastomérica",
        "volume_total_litros": round(litros_necessarios, 2),
        "metodo_aplicacao": "Airless (Galpão)",
        "durabilidade_estimada": "60 meses",
        "custo_estimado": f"R$ {round(litros_necessarios * 45.0, 2)}"
    }
