def calcular_carga_termica(area_m2, orientacao_solar):
    """
    Calcula os BTUs necessários baseados na isolação térmica do Kit Liceu.
    Cruza com dados de 'caixilhos.py' para eficiência.
    """
    fator_isolamento = 0.85  # Painéis sanduíche Liceu são eficientes
    btu_base = 600
    
    if orientacao_solar in ["OESTE", "NOROESTE"]:
        btu_base = 800  # Maior incidência solar

    total_btus = (area_m2 * btu_base) * fator_isolamento
    
    return {
        "BTU_estimado": round(total_btus, 0),
        "equipamento_sugerido": "Inverter High Efficiency",
        "eficiencia_energetica": "Selo Procel A",
        "validacao_norma": "ISO 7730 / NBR 16401"
    }
